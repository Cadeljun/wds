# WDS - Firestore Configuration - Alternative to Supabase
# Choose DB provider: NEXT_PUBLIC_DB_PROVIDER=firestore or supabase

# DB Provider Switch
NEXT_PUBLIC_DB_PROVIDER=firestore
# Options: firestore, supabase, demo (localStorage fallback)

# ===========================================
# Firebase / Firestore Config - Publishable (safe in browser, have NEXT_PUBLIC_ prefix)
# ===========================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ===========================================
# Firebase Admin - SECRET - Server-only, NO NEXT_PUBLIC_ prefix!
# Used in API routes and Cloud Functions to bypass Firestore rules
# NEVER expose to browser!
# ===========================================
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PROJECT_ID=your-project-id

# ===========================================
# Paystack Ghana - Same as Supabase version
# ===========================================
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# Secret, no NEXT_PUBLIC, server-only!

# ===========================================
# Internal Secret - For service-to-service calls
# ===========================================
INTERNAL_API_SECRET=your-random-32-char-secret
# Generate: openssl rand -hex 32
# Secret, no NEXT_PUBLIC, fails closed if missing!

# ===========================================
# Maps - Publishable but restrict to domain!
# ===========================================
NEXT_PUBLIC_MAP_PROVIDER=leaflet
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...
# Browser key, NEXT_PUBLIC okay but restrict to wds.com.gh in Google Cloud Console!

# ===========================================
# App URL
# ===========================================
NEXT_PUBLIC_APP_URL=https://wds.com.gh
# Or http://localhost:3000 for dev

# ===========================================
# Supabase - Keep for fallback or if switching back
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SERVICE_ROLE is SECRET, no NEXT_PUBLIC!
