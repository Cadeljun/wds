{
  "name": "wds-rider-mobile",
  "version": "2.0.0",
  "description": "WDS Williams Delivery Service - Rider Mobile App (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-router": "~3.5.23",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "@supabase/supabase-js": "^2.45.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "typescript": "^5.1.3",
    "@types/react": "~18.2.45"
  },
  "expo": {
    "name": "WDS Rider",
    "slug": "wds-rider",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wds-rider",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0A0A0A" },
      "package": "com.williamsdelivery.rider",
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION", "android.permission.FOREGROUND_SERVICE"]
    },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow WDS to use your location to show nearby jobs and track deliveries." }]],
    "experiments": { "typedRoutes": true }
  }
}
